    <div>
      <nav class="docs-nav-scroll" aria-label="Documentation navigation">
        <div class="docs-toc-navigation" id="toc"><%- include(`toc.md`) %></div>
      </nav>
    </div>
  </aside>

  <main class="docs-main">
    <article class="prose">
      <div id="content"><%- slots.body || slot %></div>
    </article>
  </main>
</div>
