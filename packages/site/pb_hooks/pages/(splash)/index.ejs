<div class="splash">
  <!-- Hero -->
  <section class="hero">
    <div>
      <div class="hero-brand rise">
        <span class="avatar">
          <img src="apple-touch-icon.png" alt="PocketPages Logo" />
        </span>
        <h1 class="hero-title">PocketPages</h1>
        <pre><code class="language-bash">npm create pocketpages</code></pre>
      </div>

      <h2 class="hero-tagline rise" style="--delay: 0.2s; --rise: 30px">
        No-Build Multi-Page Apps for <span>PocketBase</span>
      </h2>

      <div class="cta-row rise" style="--delay: 0.4s; --rise: 30px">
        <a href="/docs/overview" class="btn btn-accent">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253z"></path>
          </svg>
          Read the Docs
        </a>
        <a href="/docs/installation" class="btn btn-outline">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
          </svg>
          Quick Start
        </a>
      </div>

      <pre><code class="language-ejs">&lt;!-- pb_hooks/pages/index.ejs --&gt;
&lt;%= `Hello, PocketPages!` %&gt;</code></pre>

      <div class="rise" style="--delay: 0.8s; --rise: 30px; width: min(100%, 42rem)">
        <%- include(`browser.ejs`, { content: `Hello, PocketPages!` }) %>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2 class="section-title">Why PocketPages is Better</h2>
        <p class="lead">
          Zero compilation, zero bundling, zero build steps. Just write code and deploy - frontend and backend.
        </p>
      </div>

      <div class="grid">
        <div class="card center accent">
          <div class="feature-icon">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <h3>Zero Build Steps</h3>
          <p>No compilation anywhere. Write HTMX, Alpine.js, or VanJS and see changes instantly.</p>
        </div>

        <div class="card center secondary">
          <div class="feature-icon">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 002 2V9zM9 9h6v6H9V9z"></path>
            </svg>
          </div>
          <h3>Server-Side Rendered</h3>
          <p>Pages render on the server using PocketBase JSVM. Fast, SEO-friendly, and reliable.</p>
        </div>

        <div class="card center success">
          <div class="feature-icon">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
            </svg>
          </div>
          <h3>PocketBase Native</h3>
          <p>Built specifically for PocketBase JSVM (Goja). Access your data, auth, and APIs directly.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- AI agents -->
  <section class="section tight-top">
    <div class="container">
      <div class="grid two">
        <div class="stack">
          <h2 class="section-title">Ready for AI Coding Agents</h2>
          <p class="lead">
            Every new project includes the official PocketPages agent skill. Claude Code, Cursor, Codex, and other agents learn how PocketPages really works: file routing, loaders, layouts, and PocketBase's synchronous JSVM. That means fewer hallucinated <code>fetch</code> calls and <code>async</code> handlers.
          </p>
          <ul class="checklist">
            <li><span><strong>Zero setup:</strong> <code>npm create pocketpages</code> adds the skill and an <code>AGENTS.md</code></span></li>
            <li><span><strong>Existing projects:</strong> one Claude Code plugin install, or copy one folder</span></li>
            <li><span><strong>Verified against the source:</strong> maintained alongside the framework code</span></li>
          </ul>
          <div><a href="/docs/ai-agents" class="btn btn-outline">Set up your agent</a></div>
        </div>

        <div class="window">
          <header class="dots">my-pocketpages-app/</header>
          <div>
            <pre><code class="language-bash">.claude/skills/pocketpages/  # agent skill
AGENTS.md                    # rules for any agent
CLAUDE.md                    # imports AGENTS.md
pb_hooks/
  pages/
    index.ejs
package.json

# Existing project? In Claude Code:
/plugin marketplace add benallfree/pocketpages
/plugin install pocketpages@pocketpages</code></pre>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why MPAs -->
  <section class="section alt">
    <div class="container">
      <div class="section-head">
        <h2 class="section-title">Why Multi-Page Apps Matter</h2>
        <p class="lead">
          While SPAs dominate the conversation, MPAs offer proven benefits for most web applications.
          PocketPages brings this architecture to PocketBase's powerful backend.
        </p>
      </div>

      <div class="grid two">
        <div class="card glass">
          <h3>✓ MPA Advantages</h3>
          <ul class="checklist">
            <li><span><strong>Instant Page Loads:</strong> Server renders HTML, browser shows content immediately</span></li>
            <li><span><strong>SEO by Default:</strong> Search engines get fully rendered HTML</span></li>
            <li><span><strong>Progressive Enhancement:</strong> Works without JavaScript, enhanced with it</span></li>
            <li><span><strong>Simpler Mental Model:</strong> Each URL = one page, like the web was designed</span></li>
            <li><span><strong>Zero Compilation:</strong> No build steps anywhere - frontend or backend</span></li>
          </ul>
        </div>

        <div class="stack">
          <div class="window">
            <header class="dots">pb_hooks/pages/users/[id].ejs</header>
            <div>
              <pre><code class="language-javascript"><%% // Server-side data loading in PocketBase JSVM
const user = $app.findRecordById('users', params.id)
%>

&lt;!-- Template renders with live data --&gt;
<%%= user.get('name') %> joined <%%= user.get('created') %></code></pre>
            </div>
          </div>

          <div class="alert" role="note">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <div>
              <h4>PocketBase JSVM Integration</h4>
              <p>Direct access to your database, authentication, and APIs server-side.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- No-build ecosystem -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2 class="section-title">Perfect for No-Build Frontend</h2>
        <p class="lead">
          Drop in your favorite no-build frontend library and start building. No webpack configs, no bundlers, no compile steps.
        </p>
      </div>

      <div class="grid libs">
        <div class="lib" style="--hue: 260"><strong style="font-size: 1.875rem; font-weight: 900">htmx</strong><p>High power tools for HTML</p></div>
        <div class="lib" style="--hue: 163"><strong>Alpine.js</strong><p>Minimal framework for HTML</p></div>
        <div class="lib" style="--hue: 277"><strong>Datastar</strong><p>Reactive UI with data binding</p></div>
        <div class="lib" style="--hue: 70"><strong>VanJS</strong><p>Ultra-lightweight reactive UI</p></div>
        <div class="lib" style="--hue: 304"><strong>Vanilla JS</strong><p>Pure JavaScript, no dependencies</p></div>
      </div>

      <div class="grid">
        <div class="window soft">
          <header>HTMX + PocketPages</header>
          <div>
            <pre><code class="language-html">&lt;%- include('header.ejs') %&gt;

&lt;div hx-get="/api/todos"
     hx-trigger="load"
     hx-target="#todo-list"&gt;
  Loading todos...
&lt;/div&gt;

&lt;div id="todo-list"&gt;&lt;/div&gt;</code></pre>
          </div>
        </div>

        <div class="window soft">
          <header>Alpine.js + PocketPages</header>
          <div>
            <pre><code class="language-html">&lt;div x-data="{ todos: &lt;%= JSON.stringify(todos) %&gt; }"&gt;
  &lt;template x-for="todo in todos"&gt;
    &lt;div x-text="todo.title"
         :class="{ 'completed': todo.done }"&gt;
    &lt;/div&gt;
  &lt;/template&gt;
&lt;/div&gt;</code></pre>
          </div>
        </div>

        <div class="window soft">
          <header>Datastar + PocketPages</header>
          <div>
            <pre><code class="language-html">&lt;input type="text"
       name="message"
       data-bind-message /&gt;

&lt;button data-on-click="@get('/api/chat')"&gt;
  Send
&lt;/button&gt;

&lt;div id="chat-box"&gt;
  &lt;% for (const msg of store('messages')||[]) { %&gt;
    &lt;div&gt;&lt;%= msg.message %&gt;&lt;/div&gt;
  &lt;% } %&gt;
&lt;/div&gt;</code></pre>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>
