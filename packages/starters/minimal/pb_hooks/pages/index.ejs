<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PocketPages - Build Fast</title>
    <style>
      /* Base */
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
      }
      body {
        min-height: 100vh;
        position: relative;
        overflow: hidden;
        font-family:
          ui-sans-serif,
          system-ui,
          sans-serif,
          'Apple Color Emoji',
          'Segoe UI Emoji',
          'Segoe UI Symbol',
          'Noto Color Emoji';
        line-height: 1.5;
        background: linear-gradient(
          135deg,
          #7c3aed 0%,
          #2563eb 50%,
          #14b8a6 100%
        );
      }
      a {
        color: inherit;
        text-decoration: none;
      }

      /* Animated background blobs */
      .blobs {
        position: absolute;
        inset: 0;
        overflow: hidden;
      }
      .blob {
        position: absolute;
        width: 20rem;
        height: 20rem;
        border-radius: 9999px;
        mix-blend-mode: multiply;
        filter: blur(24px);
        opacity: 0.7;
        animation: blob 7s infinite;
      }
      .blob-1 {
        top: -10rem;
        right: -10rem;
        background: #d8b4fe;
      }
      .blob-2 {
        bottom: -10rem;
        left: -10rem;
        background: #fde047;
        animation-delay: 2s;
      }
      .blob-3 {
        top: 10rem;
        left: 10rem;
        background: #f9a8d4;
        animation-delay: 4s;
      }

      /* Layout */
      .page {
        position: relative;
        z-index: 10;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
      }
      .content {
        max-width: 56rem;
        margin: 0 auto;
        text-align: center;
      }
      .content > * + * {
        margin-top: 2rem;
      }

      .glass-card {
        backdrop-filter: blur(16px);
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 1rem;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
      }

      /* Hero */
      .hero {
        padding: 3rem;
        animation: fade-in-up 1s ease-out;
      }
      .hero > * + * {
        margin-top: 1.5rem;
      }
      .title-wrap {
        display: inline-block;
      }
      .title {
        font-size: 3.75rem;
        line-height: 1;
        font-weight: 700;
        background: linear-gradient(
          90deg,
          #a855f7 0%,
          #ec4899 50%,
          #3b82f6 100%
        );
        background-clip: text;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        color: transparent;
      }
      .tagline {
        font-size: 1.25rem;
        line-height: 1.75rem;
        font-weight: 300;
        letter-spacing: 0.025em;
        color: rgba(255, 255, 255, 0.9);
      }
      .divider {
        width: 6rem;
        height: 0.25rem;
        margin-left: auto;
        margin-right: auto;
        border-radius: 9999px;
        background: linear-gradient(to right, #c084fc, #3b82f6);
      }

      /* Feature cards */
      .features {
        display: grid;
        gap: 1.5rem;
      }
      .feature {
        padding: 1.5rem;
        cursor: pointer;
        transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
      }
      .feature:hover {
        transform: scale(1.05);
      }
      .feature-icon {
        font-size: 2.25rem;
        line-height: 2.5rem;
        margin-bottom: 1rem;
      }
      .feature h3 {
        font-size: 1.25rem;
        line-height: 1.75rem;
        font-weight: 600;
        color: white;
        margin-bottom: 0.5rem;
      }
      .feature p {
        color: rgba(255, 255, 255, 0.7);
      }

      /* Buttons */
      .actions {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        justify-content: center;
        align-items: center;
      }
      .btn-primary {
        padding: 1rem 2rem;
        background: linear-gradient(90deg, #8b5cf6 0%, #3b82f6 100%);
        color: white;
        font-weight: 600;
        border-radius: 0.75rem;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        transition: all 0.3s ease;
        transform: scale(1);
      }
      .btn-primary:hover {
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
        transform: scale(1.05);
      }
      .btn-secondary {
        padding: 1rem 2rem;
        border: 2px solid rgba(255, 255, 255, 0.3);
        color: white;
        font-weight: 600;
        border-radius: 0.75rem;
        transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
      }
      .btn-secondary:hover {
        background: rgba(255, 255, 255, 0.1);
      }

      /* Floating particles */
      .particles {
        position: fixed;
        inset: 0;
        pointer-events: none;
      }
      .particle {
        position: absolute;
        border-radius: 9999px;
        animation: float 6s ease-in-out infinite;
      }
      .particle-1 {
        top: 5rem;
        left: 5rem;
        width: 0.5rem;
        height: 0.5rem;
        background: rgba(255, 255, 255, 0.3);
      }
      .particle-2 {
        top: 10rem;
        right: 8rem;
        width: 0.25rem;
        height: 0.25rem;
        background: rgba(216, 180, 254, 0.5);
        animation-delay: 1s;
      }
      .particle-3 {
        bottom: 8rem;
        left: 8rem;
        width: 0.75rem;
        height: 0.75rem;
        background: rgba(147, 197, 253, 0.4);
        animation-delay: 2s;
      }
      .particle-4 {
        bottom: 5rem;
        right: 5rem;
        width: 0.5rem;
        height: 0.5rem;
        background: rgba(249, 168, 212, 0.5);
        animation-delay: 3s;
      }

      /* Larger screens */
      @media (min-width: 640px) {
        .actions {
          flex-direction: row;
        }
      }
      @media (min-width: 768px) {
        .title {
          font-size: 6rem;
        }
        .tagline {
          font-size: 1.5rem;
          line-height: 2rem;
        }
        .features {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
      }

      /* Animations */
      @keyframes blob {
        0% {
          transform: translate(0px, 0px) scale(1);
        }
        33% {
          transform: translate(30px, -50px) scale(1.1);
        }
        66% {
          transform: translate(-20px, 20px) scale(0.9);
        }
        100% {
          transform: translate(0px, 0px) scale(1);
        }
      }
      @keyframes float {
        0%,
        100% {
          transform: translateY(0px);
        }
        50% {
          transform: translateY(-20px);
        }
      }
      @keyframes fade-in-up {
        from {
          opacity: 0;
          transform: translateY(30px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
    </style>
  </head>
  <body>
    <!-- Animated background elements -->
    <div class="blobs">
      <div class="blob blob-1"></div>
      <div class="blob blob-2"></div>
      <div class="blob blob-3"></div>
    </div>

    <!-- Main content -->
    <div class="page">
      <div class="content">
        <!-- Hero section -->
        <div class="glass-card hero">
          <div class="title-wrap">
            <h1 class="title">PocketPages</h1>
          </div>
          <p class="tagline">
            Build lightning-fast web applications with the power of PocketBase
          </p>
          <div class="divider"></div>
        </div>

        <!-- Feature cards -->
        <div class="features">
          <div class="glass-card feature">
            <div class="feature-icon">⚡</div>
            <h3>Lightning Fast</h3>
            <p>Server-side rendering with PocketBase's powerful backend</p>
          </div>
          <div class="glass-card feature">
            <div class="feature-icon">🚀</div>
            <h3>Zero Config</h3>
            <p>Get started in seconds with minimal setup required</p>
          </div>
          <div class="glass-card feature">
            <div class="feature-icon">🎨</div>
            <h3>Beautiful UI</h3>
            <p>Stunning designs with modern CSS frameworks like UnoCSS</p>
          </div>
        </div>

        <!-- CTA buttons -->
        <div class="actions">
          <a href="https://pocketpages.dev" class="btn-primary">Get Started →</a>
          <a href="https://pocketpages.dev/docs" class="btn-secondary">
            View Docs
          </a>
        </div>
      </div>
    </div>

    <!-- Floating particles -->
    <div class="particles">
      <div class="particle particle-1"></div>
      <div class="particle particle-2"></div>
      <div class="particle particle-3"></div>
      <div class="particle particle-4"></div>
    </div>
  </body>
</html>
