<script server>
  const errorMessage = resolve('errors')
  let error = null
  try {
    confirmVerification(params.token)
    redirect('/', {
      message: 'Your account has been verified.',
    })
    return
  } catch (e) {
    error = errorMessage(e)
  }
</script>
<h2>Verify Account</h2>
<mark>This verification link is invalid or has expired (<%= error %>).</mark>
<p><a href="/auth/verify">Send a new verification email</a></p>
