<script server>
  const errorMessage = resolve('errors')
  let error = null

  if (request.method === 'POST') {
    const { password, passwordConfirm } = body()
    try {
      pb()
        .collection('users')
        .confirmPasswordReset(params.token, password, passwordConfirm)
      // A reset invalidates existing sessions, so clear ours too.
      signOut()
      redirect('/auth/login', {
        message: 'Your password has been reset. Log in with your new password.',
      })
      return
    } catch (e) {
      error = errorMessage(e)
    }
  }
</script>
<h2>Choose a New Password</h2>
<% if (error) { %>
<mark><%= error %></mark>
<% } %>
<form method="post">
  <label>New password</label>
  <input name="password" type="password" required minlength="8" />
  <label>Confirm new password</label>
  <input name="passwordConfirm" type="password" required minlength="8" />
  <button type="submit">Reset Password</button>
</form>
<p>Link expired? <a href="/auth/forgot">Request a new one</a>.</p>
