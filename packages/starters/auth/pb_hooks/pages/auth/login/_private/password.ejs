<script server>
  let error = null
  const methods = pb().collection('users').listAuthMethods();
  dbg({
    methods
  })

  if (request.method === 'POST' && body().mode === 'password') {
    const {
      identity,
      password,
      mode
    } = body()

    try {
      const user = signInWithPassword(identity, password)
      dbg({
        user
      })
      redirect(`/`)
    } catch (e) {
      // MFA is on for this user: email a code and finish on /auth/login/mfa
      const mfa = resolve('mfa-state')
      const mfaId = mfa.mfaIdFrom(e)
      if (mfaId) {
        const { otpId } = requestOTP(identity)
        mfa.start(response, { mfaId, otpId, identity, next: 'otp' })
        redirect('/auth/login/mfa')
        return
      }
      error = resolve('errors')(e)
    }
  }
</script>
<h3>Password Login</h3>
<% if (error) { %>
<mark><%= error %></mark>
<% } %>
<% if (!methods.password.enabled) { %>
<mark>Password login is disabled. See README.md for details.</mark>
<% } else { %>
<form method="post">
  <input type="hidden" name="mode" value="password" />
  <label>Email</label>
  <input name="identity" value="<%= data.identity %>" />
  <label>Password</label>
  <input name="password" type="password" />
  <button type="submit">Login</button>
  <a href="/auth/forgot">Forgot Password</a>
</form>
<% } %>