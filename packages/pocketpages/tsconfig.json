{
  "compilerOptions": {
    "types": ["pocketbase-jsvm"],
    "strict": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitAny": true,
    "target": "ES6",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "$util/*": ["src/lib/util/*"]
    }
  },
  "include": ["src/**/*"],
  // Tests run under Bun and are checked by tsconfig.test.json
  "exclude": ["src/**/*.test.ts"]
}
